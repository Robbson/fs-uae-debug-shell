{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Debug Shell scenario configuration",
  "description": "Named watchpoint scenarios loaded from config.yaml. The wrapper validates this file at startup and aborts with a located message on the first problem; this schema mirrors those rules for editors.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "memwatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "description": "Values applied to every scenario entry unless the entry overrides them.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "flags": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z]+$"
              }
            }
          }
        },
        "scenarios": {
          "description": "Scenario name to a non-empty list of watchpoints.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "address"],
              "properties": {
                "name": {
                  "description": "Alias shown in place of the watchpoint number.",
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\s,:]+$"
                },
                "address": {
                  "description": "Hexadecimal address; quote it so YAML cannot read it as a number.",
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^(\\$|0[xX])?[0-9A-Fa-f]+$"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "length": {
                  "type": "integer",
                  "minimum": 1
                },
                "flags": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z]+$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
